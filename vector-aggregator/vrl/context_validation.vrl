# ─────────────────────────────────────────────────────────────
# VRL: Context Validation
# REQ-2.6 — Enforce required metadata fields
#
# Validates: trace_id, span_id, timestamp, service.name
# Flags invalid events for DLQ routing
# ─────────────────────────────────────────────────────────────

# Default: not invalid
.is_invalid = false

# Ensure timestamp exists and is valid
if !exists(.timestamp) {
    .timestamp = now()
    .validation_warning = "timestamp_injected"
}

# Validate trace_id (must be 32-char hex string)
if exists(.trace_id) {
    trace_id_str = string!(.trace_id)
    if !match(trace_id_str, r'^[a-fA-F0-9]{32}$') {
        .is_invalid = true
        .invalid_reason = "malformed_trace_id"
    }
} else {
    .is_invalid = true
    .invalid_reason = "missing_trace_id"
}

# Validate span_id (must be 16-char hex string)
if exists(.span_id) {
    span_id_str = string!(.span_id)
    if !match(span_id_str, r'^[a-fA-F0-9]{16}$') {
        .is_invalid = true
        .invalid_reason = "malformed_span_id"
    }
}

# Validate service.name is present
if !exists(.service) || !exists(.service.name) {
    if !exists(.service_name) {
        .is_invalid = true
        .invalid_reason = "missing_service_name"
    } else {
        # Normalize: move service_name into service.name
        .service.name = del(.service_name)
    }
}

# Ensure severity is present (default to INFO)
if !exists(.severity) {
    .severity = "INFO"
}

# Tag validated events with aggregator metadata
.aggregator_received_at = now()
.aggregator_node = get_hostname!()

.
